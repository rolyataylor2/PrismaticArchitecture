# OntoAgentic provider credentials
# CLI/server read .env from the current directory; exported shell values take precedence.
# Never commit real API keys.

OPENAI_API_KEY=
JEV_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
JEV_MODEL=jev-latest
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.3
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Executable TypeScript demo
ONTOAGENTIC_PROVIDER=mock
ONTOAGENTIC_DECISIONS=mock
ONTOAGENTIC_DB=workspace/agents/local.sqlite
# Saved experimental databases appear in the normal Agent selector.
# Each immediate subdirectory may contain research.sqlite.
ONTOAGENTIC_RESEARCH_ROOT=workspace/gauntlet
# Immutable Agent Skills package snapshots (configurable outside this repository).
ONTOAGENTIC_SKILLS_ROOT=workspace/skills
PORT=3000
# For live OpenAI + Jev: ONTOAGENTIC_PROVIDER=openai and ONTOAGENTIC_DECISIONS=jev
# For hosted xAI + Jev: ONTOAGENTIC_PROVIDER=xai and ONTOAGENTIC_DECISIONS=jev
# Grok 4.3 requests use reasoning effort none. Agent Settings can also select it.
# For local Ollama: ONTOAGENTIC_PROVIDER=ollama and ONTOAGENTIC_DECISIONS=ollama
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
