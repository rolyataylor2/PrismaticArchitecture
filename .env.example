# The Prism Agent Architecture provider credentials
# CLI/server read .env from the current directory; exported shell values take precedence.
# Never commit real API keys.

OPENAI_API_KEY=
JEV_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
JEV_MODEL=jev-latest
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
QWEN_API_KEY=
QWEN_MODEL=qwen-flash
# Set your region/workspace endpoint when required by the Alibaba key.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
XAI_API_KEY=
XAI_MODEL=grok-4.3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Executable TypeScript demo
PRISM_PROVIDER=mock
PRISM_DECISIONS=mock
PRISM_DB=workspace/agents/local.sqlite
# Saved experimental databases appear in the normal Agent selector.
# Each immediate subdirectory may contain research.sqlite.
PRISM_RESEARCH_ROOT=workspace/gauntlet
# Immutable Agent Skills package snapshots (configurable outside this repository).
PRISM_SKILLS_ROOT=workspace/skills
PORT=3000
# For live OpenAI + Jev: PRISM_PROVIDER=openai and PRISM_DECISIONS=jev
# For hosted xAI + Jev: PRISM_PROVIDER=xai and PRISM_DECISIONS=jev
# Grok 4.3 requests use reasoning effort none. Agent Settings can also select it.
# For local Ollama: PRISM_PROVIDER=ollama and PRISM_DECISIONS=ollama
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# PRISM_PROVIDER also accepts gemini, qwen, or openrouter; use PRISM_DECISIONS=jev.
# Per-Agent provider connections and model selections can instead be set in the UI.
